# ==========================================
# 🙈 GITIGNORE FOR SAAS E-COMMERCE BACKEND
# ==========================================

# 1. Dependency Modules (Never commit node_modules)
node_modules/
/node_modules

# 2. Environment Secrets & Keys
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# 3. Database Files (Allow dev.db for instant project setup)
!prisma/dev.db
prisma/*.db-journal
*.db-journal

# 4. Media Uploads (Allow product catalog images for GitHub repo)
public/uploads/*
!public/uploads/.gitkeep
!public/uploads/products/*

# 5. System Logs & Output
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# 6. OS & IDE Specific Files
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
