# =========================================================================
# ⚙️ SAAS E-COMMERCE BACKEND ENVIRONMENT VARIABLES SAMPLE (.env.example)
# Note: Copy this file to '.env' and fill in your actual credentials.
# =========================================================================

# Server Configuration
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# JWT Authentication Settings
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=24h

# Database Configuration (SQLite / PostgreSQL / MongoDB / Redis)
DATABASE_URL="file:./dev.db"
MONGO_URI=mongodb://localhost:27017/saas_ecommerce
REDIS_URL=redis://localhost:6379

# Razorpay Payment Gateway Credentials (Test Keys from Razorpay Dashboard)
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# Support Email & SMTP Service Credentials
SUPPORT_EMAIL=support@example.com
SMTP_USER=your_smtp_email_here
SMTP_PASS=your_smtp_password_here
